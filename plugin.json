{
  "pluginName": "位计算器",
  "version": "0.7.0",
  "description": "位网格与数值分屏：窗口内直接写表达式，拖选位域即取值/写值，支持位宽、字节序、IEEE754、协议字段与命名方案，带历史记录。",
  "author": "qmfr",
  "homepage": "https://github.com/qmjianda/utools-bitcalc",
  "main": "index.html",
  "logo": "logo.png",
  "features": [
    {
      "code": "bitcalc",
      "description": "位计算器：表达式求值 + bit 网格，支持位宽 / 字节序 / 浮点 / 协议字段",
      "cmds": [
        "bitcalc",
        {
          "type": "regex",
          "label": "位计算",
          "match": "/^0[xX][0-9a-fA-F]{1,16}$|^0[bB][01]{1,64}$|^0[oO][0-7]{1,22}$/"
        },
        {
          "type": "regex",
          "label": "按位计算",
          "match": "/^[\\s0-9a-fA-FxX()]*[<>&|^~][\\s0-9a-fA-FxX()<>&|^~]*$/",
          "minLength": 3,
          "maxLength": 72
        }
      ]
    }
  ]
}
