{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "pluginSetting": {
    "height": 580
  },
  "features": [
    {
      "code": "bitcalc",
      "description": "64 位整数与位域工具：表达式计算、位段读写、字段解码",
      "cmds": [
        "bitcalc",
        "位运算计算器",
        {
          "type": "regex",
          "label": "位运算计算",
          "match": "/^(?=[\\s\\S]*?(?:0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|\\b[01]{4,}\\b))(?=[\\s\\S]*?(?:[+\\-*/%&|^~<>()]|0[xXbBoO]))[\\s\\d+\\-*/%&|^~<>()a-fA-FxXbBoO_.]{1,120}$|^(?=[\\s\\S]*?(?:[&|^~]|<<|>>))[\\s\\d+\\-*/%&|^~<>()]{1,120}$/"
        }
      ]
    }
  ]
}
